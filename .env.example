# Supabase — from the project dashboard: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the door device endpoint to call record_tap().
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Kavenegar — Supabase has no built-in Iranian SMS provider, so OTP is
# delivered through an auth Send SMS hook that calls this.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=fitclub-otp

# ZarinPal — subscription payments
ZARINPAL_MERCHANT_ID=
