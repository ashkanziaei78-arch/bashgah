# Public Supabase connection for the deployed app.
#
# Committed deliberately, at the owner's explicit request, so the hosted
# build has credentials without a dashboard step.
#
# Both values carry the NEXT_PUBLIC_ prefix, which means Next.js compiles
# them into the JavaScript every visitor downloads. Keeping them out of
# the repository would hide nothing. What actually guards the data is row
# level security, which every table has.
#
# Real environment variables override this file, so setting these in the
# Vercel dashboard later takes precedence without touching the code.
#
# NEVER add SUPABASE_SERVICE_ROLE_KEY here. It bypasses row level
# security entirely and belongs only in an untracked .env.local or the
# host's secret store.
NEXT_PUBLIC_SUPABASE_URL=https://mgcqrayshrgnmcpostxi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_IZHu33YEBiKuYBWHmZ3yKA_Arg5L7DQ
