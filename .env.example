# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to create member accounts and by the door device.
# Bypasses row level security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# sms.ir — Supabase ships no Iranian SMS provider, so OTP is delivered
# through an auth Send SMS hook that calls this. See README → SMS.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=

# ZarinPal — subscription payments
ZARINPAL_MERCHANT_ID=
