# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to create member accounts and by the door device.
# Bypasses row level security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Dev only. /dev-login signs into the seeded accounts with this; the page
# 404s in production. No default — the repo carries no credential.
NEXT_PUBLIC_DEV_PASSWORD=

# ZarinPal — subscription payments
ZARINPAL_MERCHANT_ID=

# Pexels — free key from pexels.com/api. Only used by `npm run photos`,
# which fills the image buckets. The Pexels licence allows commercial use.
PEXELS_API_KEY=
